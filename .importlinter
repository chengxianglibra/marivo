[importlinter]
root_package = marivo
exclude_type_checking_imports = false
include_external_packages = true

[importlinter:contract:top-level-layers]
name = Every Marivo package has an explicit dependency layer
type = layers
containers = marivo
exhaustive = true
layers =
    __main__
    cli
    server | skills
    _help
    analysis
    ontology
    semantic
    datasource
    _authoring
    _definition | introspection | telemetry
    _kernel

[importlinter:contract:no-sibling-cycles]
name = Shared implementation packages have no sibling import cycles
type = acyclic_siblings
ancestors =
    marivo._help
    marivo._kernel
    marivo._definition
    marivo._authoring
    marivo.introspection
    marivo.introspection.capabilities
    marivo.telemetry
    marivo.analysis._help_specs
    marivo.datasource
    marivo.datasource._help_specs
    marivo.datasource.credentials
    marivo.datasource.engines
    marivo.datasource.inspection
    marivo.datasource.runtime
    marivo.datasource.store
    marivo.semantic
    marivo.semantic._help_specs
    marivo.semantic.authoring
    marivo.semantic.catalog_model
    marivo.semantic.expressions
    marivo.semantic.runtime_check
    marivo.semantic.search
    marivo.semantic.static_check
    marivo.ontology._help_specs

[importlinter:contract:pure-layers-no-heavy-runtime]
name = Pure analysis and shared primitives exclude execution dependencies
type = forbidden
source_modules =
    marivo._kernel
    marivo._definition
    marivo.analysis.model
forbidden_modules =
    pandas
    pyarrow
    numpy
    duckdb
    sqlglot
    uvicorn
    onnxruntime
    sentence_transformers

[importlinter:contract:datasource-is-leaf]
name = datasource must not depend on semantic or analysis
type = forbidden
source_modules =
    marivo.datasource
forbidden_modules =
    marivo.semantic
    marivo.analysis

[importlinter:contract:semantic-does-not-import-analysis]
name = semantic must not depend on analysis
type = forbidden
source_modules =
    marivo.semantic
forbidden_modules =
    marivo.analysis

[importlinter:contract:live-is-neutral-leaf]
name = Shared Help must not depend on domain implementations
type = forbidden
source_modules =
    marivo.introspection.live
    marivo.introspection.capabilities
forbidden_modules =
    marivo.datasource
    marivo.semantic
    marivo.analysis
    marivo._authoring

[importlinter:contract:authoring-is-private-domain-kernel]
name = _authoring must not depend on surfaces
type = forbidden
source_modules =
    marivo._authoring
forbidden_modules =
    marivo.datasource
    marivo.semantic
    marivo.analysis

[importlinter:contract:definition-is-neutral-leaf]
name = _definition may use Ibis recipes but not surfaces or execution engines
type = forbidden
source_modules =
    marivo._definition
forbidden_modules =
    marivo.datasource
    marivo.semantic
    marivo.analysis
    pandas
    pyarrow
    duckdb

[importlinter:contract:analysis-execution-layers]
name = Session and DSL control invocation, execution and local methods
type = layers
containers = marivo.analysis
layers =
    session
    dsl
    materialization
    methods
    compiler
    model

[importlinter:contract:analysis-model-no-heavy-runtime]
name = Analysis model must not import dataframe, backend or validation implementations
type = forbidden
source_modules =
    marivo.analysis.model
forbidden_modules =
    pandas
    ibis
    pyarrow
    duckdb
    pydantic

[importlinter:contract:dataset-compiler-isolation]
name = Dataset compilation must not depend on runtime publication
type = forbidden
source_modules =
    marivo.analysis.compiler
forbidden_modules =
    marivo.analysis.materialization
    marivo.analysis.session

[importlinter:contract:ontology-isolation]
name = Ontology must not depend on analysis or application entrypoints
type = forbidden
source_modules =
    marivo.ontology
forbidden_modules =
    marivo.analysis
    marivo.server
    marivo.cli

[importlinter:contract:ontology-no-direct-datasource]
name = Ontology must not import datasource directly
type = forbidden
source_modules =
    marivo.ontology
forbidden_modules =
    marivo.datasource
# The semantic catalog owns datasource resolution for ontology.
allow_indirect_imports = true

[importlinter:contract:telemetry-is-leaf]
name = Telemetry must not depend on domain implementations or server
type = forbidden
source_modules =
    marivo.telemetry
forbidden_modules =
    marivo.datasource
    marivo.semantic
    marivo.analysis
    marivo.ontology
    marivo.server

[importlinter:contract:core-domains-no-app-shell]
name = Core domains must not depend on application entrypoints
type = forbidden
source_modules =
    marivo.datasource
    marivo.semantic
    marivo.analysis
    marivo.ontology
forbidden_modules =
    marivo.server
    marivo.cli

[importlinter:contract:engines-independent]
name = Datasource engine implementations are independent
type = independence
modules =
    marivo.datasource.engines.duckdb
    marivo.datasource.engines.postgres
    marivo.datasource.engines.mysql
    marivo.datasource.engines.trino
    marivo.datasource.engines.clickhouse


[importlinter:contract:engines-protected]
name = Only datasource engines import concrete engine implementations
type = protected
protected_modules =
    marivo.datasource.engines.duckdb
    marivo.datasource.engines.postgres
    marivo.datasource.engines.mysql
    marivo.datasource.engines.mysql_query
    marivo.datasource.engines._mysql_backend
    marivo.datasource.engines.trino
    marivo.datasource.engines.trino_query
    marivo.datasource.engines.clickhouse
    marivo.datasource.engines.clickhouse_query
allowed_importers =
    marivo.datasource.engines

[importlinter:contract:spi-only-cross-domain]
name = Semantic implementation imports stay inside the owning domain
type = protected
protected_modules =
    marivo.semantic._aggregate_accuracy
    marivo.semantic._help_specs
    marivo.semantic._catalog_definition
    marivo.semantic._compiled_state
    marivo.semantic._consumption
    marivo.semantic._deferred_semantics
    marivo.semantic._definition_display
    marivo.semantic._definition_expression
    marivo.semantic._definition_expression_types
    marivo.semantic._definition_identity
    marivo.semantic._expression_binding
    marivo.semantic._expression_values
    marivo.semantic._formula_display
    marivo.semantic._ibis_builtin_udf
    marivo.semantic._metric_time_disclosure
    marivo.semantic._model_source
    marivo.semantic._numeric_duration
    marivo.semantic._numeric_lowering
    marivo.semantic._numeric_recipe
    marivo.semantic._paths
    marivo.semantic._rescale
    marivo.semantic._symbolic_binding
    marivo.semantic.authoring
    marivo.semantic.catalog
    marivo.semantic.catalog_consumption
    marivo.semantic.catalog_discovery
    marivo.semantic.catalog_entries
    marivo.semantic.catalog_load
    marivo.semantic.catalog_model
    marivo.semantic.catalog_previews
    marivo.semantic.check
    marivo.semantic.compiled_types
    marivo.semantic.constraints
    marivo.semantic.declaration_records
    marivo.semantic.declaration_scope
    marivo.semantic.definition_resolution
    marivo.semantic.dtos
    marivo.semantic.error_repairs
    marivo.semantic.expressions
    marivo.semantic.input_scope
    marivo.semantic.ir
    marivo.semantic.loader
    marivo.semantic.loading_context
    marivo.semantic.metric_time_bindings
    marivo.semantic.numeric_operations
    marivo.semantic.paths
    marivo.semantic.policies
    marivo.semantic.reader
    marivo.semantic.readiness
    marivo.semantic.runtime_check
    marivo.semantic.search
    marivo.semantic.state_consumption
    marivo.semantic.static_check
    marivo.semantic.time_format
    marivo.semantic.unit_algebra
allowed_importers =
    marivo.semantic

[importlinter:contract:datasource-spi-only]
name = Datasource implementation imports stay inside the owning domain
type = protected
protected_modules =
    marivo.datasource._help_specs
    marivo.datasource._expression_fields
    marivo.datasource._lifetime
    marivo.datasource.arrow_types
    marivo.datasource.constraints
    marivo.datasource.credentials
    marivo.datasource.engines
    marivo.datasource.inspection
    marivo.datasource.ir
    marivo.datasource.locations
    marivo.datasource.metadata_types
    marivo.datasource.runtime
    marivo.datasource.source
    marivo.datasource.store
    marivo.datasource.temporal_primitives
allowed_importers =
    marivo.datasource

[importlinter:contract:analysis-read-spi-only]
name = Analysis implementation imports stay inside the owning domain
type = protected
protected_modules =
    marivo.analysis._help_specs
    marivo.analysis._public
    marivo.analysis._scope
    marivo.analysis.binding
    marivo.analysis.compiler
    marivo.analysis.core
    marivo.analysis.dsl
    marivo.analysis.materialization
    marivo.analysis.methods
    marivo.analysis.model
    marivo.analysis.session._disclosure
    marivo.analysis.session._lazy_frames
    marivo.analysis.session._lazy_history
    marivo.analysis.session._lazy_read_model
    marivo.analysis.session._lazy_runtime_reads
    marivo.analysis.session._lazy_sources
    marivo.analysis.session._method_disclosure
    marivo.analysis.session.core
    marivo.analysis.timezone
allowed_importers =
    marivo.analysis

[importlinter:contract:ontology-spi-only]
name = Ontology implementation imports stay inside the owning domain
type = protected
protected_modules =
    marivo.ontology._authoring
    marivo.ontology._help_specs
    marivo.ontology.catalog
    marivo.ontology.types
allowed_importers =
    marivo.ontology
