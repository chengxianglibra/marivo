[importlinter]
root_package = marivo
exclude_type_checking_imports = true
include_external_packages = true

[importlinter:contract:datasource-is-leaf]
name = datasource must not depend on semantic or analysis
type = forbidden
source_modules =
    marivo.datasource
forbidden_modules =
    marivo.semantic
    marivo.analysis

[importlinter:contract:semantic-does-not-import-analysis]
name = semantic must not depend on analysis
type = forbidden
source_modules =
    marivo.semantic
forbidden_modules =
    marivo.analysis

[importlinter:contract:analysis-evidence-isolation]
name = analysis.evidence must not import analysis internals beyond evidence + frames + lineage + refs + errors + session.persistence
type = forbidden
source_modules =
    marivo.analysis.evidence
forbidden_modules =
    marivo.analysis.intents
    marivo.analysis.executor
    marivo.analysis.calendar
    marivo.analysis.windows
    marivo.analysis.datasources
    marivo.analysis.profiles
    marivo.analysis.policies
# Frame metadata is an allowed evidence dependency. These frames declare a
# TimeScope field, so evidence reaches marivo.analysis.windows only through
# frames. Evidence itself must still never import marivo.analysis.windows.
ignore_imports =
    marivo.analysis.frames.event -> marivo.analysis.windows.spec
    marivo.analysis.frames.lifecycle -> marivo.analysis.windows.spec

[importlinter:contract:live-is-neutral-leaf]
name = introspection.live must not depend on datasource, semantic, or analysis
type = forbidden
source_modules =
    marivo.introspection.live
forbidden_modules =
    marivo.datasource
    marivo.semantic
    marivo.analysis
    marivo._authoring

[importlinter:contract:authoring-is-private-domain-kernel]
name = _authoring must not depend on surfaces
type = forbidden
source_modules =
    marivo._authoring
forbidden_modules =
    marivo.datasource
    marivo.semantic
    marivo.analysis

[importlinter:contract:dataset-core-is-foundational]
name = Dataset Core must not depend on eager or executing analysis implementations
type = forbidden
source_modules =
    marivo.analysis.datasets
forbidden_modules =
    marivo.analysis.frames
    marivo.analysis.intents
    marivo.analysis.executor
    marivo.analysis.session
    marivo.analysis.observation
    marivo.analysis.compiler
    marivo.analysis.materialization
    marivo.analysis.operators
    marivo.analysis.domains

[importlinter:contract:dataset-core-has-no-backend-imports]
name = Dataset Core must not import dataframe or backend implementations
type = forbidden
source_modules =
    marivo.analysis.datasets
forbidden_modules =
    pandas
    ibis
    pyarrow
    duckdb
# These exact existing error and semantic-descriptor edges reach legacy backend
# dependencies. All other direct and indirect Core backend paths remain forbidden.
# The separate foundational contract keeps its full transitive enforcement.
ignore_imports =
    marivo.analysis.datasets.errors -> marivo.analysis.errors
    marivo.analysis.datasets.fields -> marivo.semantic.catalog
    marivo.analysis.datasets.fields -> marivo.semantic.runtime_metric

[importlinter:contract:observation-definition-isolation]
name = Private observation definitions must not depend on eager or executing analysis
type = forbidden
source_modules =
    marivo.analysis.observation
forbidden_modules =
    marivo.analysis.frames
    marivo.analysis.intents
    marivo.analysis.executor
    marivo.analysis.session
    marivo.analysis.compiler
    marivo.analysis.materialization

[importlinter:contract:dataset-compiler-isolation]
name = Private Dataset compilation must not depend on runtime publication or eager execution
type = forbidden
source_modules =
    marivo.analysis.compiler
forbidden_modules =
    marivo.analysis.materialization
    marivo.analysis.session
    marivo.analysis.frames
    marivo.analysis.intents
    marivo.analysis.executor
