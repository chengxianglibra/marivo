---
import marivoMark from '../assets/marivo-mark.svg';
import marivoMarkAnimated from '../assets/marivo-mark-animated.webp';

interface Props {
  locale: 'en' | 'zh-cn';
}

const { locale } = Astro.props;
const isZh = locale === 'zh-cn';
const githubUrl = 'https://github.com/chengxianglibra/marivo';
const discordUrl = 'https://discord.gg/8WqCzeaYk';
const homeUrl = isZh ? '/zh-cn/' : '/';
const docsUrl = isZh ? '/zh-cn/docs/latest/' : '/docs/latest/';
const blogUrl = isZh ? '/zh-cn/blog/' : '/blog/';
const languageUrl = isZh ? '/' : '/zh-cn/';

const copy = isZh
  ? {
      lang: 'zh-CN', description: 'Marivo 是面向 Agent 的数据分析 Harness，让开放式分析建立在明确语义、类型化操作、持久会话与可追溯证据之上。', title: 'Marivo · 让智能自由探索，让约束守住事实', homeLabel: 'Marivo 主页', navLabel: '主要导航', language: 'English',
      eyebrow: '面向 Agent 的数据分析 Harness', headline: ['让智能自由探索', '让约束守住事实'], heroCopy: 'Marivo 不替 Agent 思考。它把业务语义、分析过程、会话状态和证据连接起来，让每一个影响运营、治理与决策的分析结论，都能够被检查、继续和追溯。', start: '开始使用', github: '查看 GitHub', readBlog: '阅读 Marivo 的设计与实践',
      pathLabel: '01 / 分析路径', pathTitle: '从一个开放问题，到可以交付的结论', pathIntro: 'Agent 可以自由决定调查方向，但每一步都发生在可理解、可验证的边界内。', questionLabel: '业务问题', question: '为什么上季度收入下降？我们应该优先调整哪个区域？', questionMeta: ['目标明确', '口径待确认'],
      steps: [['语义', '我们在谈论什么', '定义'], ['分析', '可以怎样推进', '探索'], ['会话', '已经做过什么', '记录'], ['证据', '结论由什么支持', '追溯']], handoffLabel: '分析交接', handoff: '结论、关键证据与限制保持在一起。', inspectable: '可检查',
      foundationLabel: '02 / 四块基础', foundationTitle: '约束不是为了减少智能，而是让智能产生价值', foundations: [['共同理解业务', '把指标、维度、关系和使用边界变成可复用的业务契约，不让每次分析重新猜测。', 'Semantic Layer'], ['沿明确操作推进', 'Agent 仍然选择下一步，但输入、输出和失败边界是清楚的，分析不会藏在一段答案里。', 'Typed Analysis DSL'], ['保留调查上下文', '问题、中间结果与分析产物持续留在同一条调查线上，可以恢复，也可以继续。', 'Analysis Session'], ['让结论回到事实', '关键判断始终能回到来源结果、分析范围和必要限制，可信与可追溯成为交付条件。', 'Evidence']],
      philosophyLabel: 'Marivo 的设计哲学', philosophyTitle: ['让智能自由探索，', '让约束守住事实。'], philosophyCopy: '对个人分析，错误也许只是一次返工；对企业分析，结论会进入运营、治理和决策。当分析开始产生业务后果，可信与可追溯就不再是附加能力，而是分析能够被使用的前提。', signalLabel: '可信分析的三个条件', signals: ['定义可检查', '过程可继续', '结论可追溯'],
      destinationsLabel: '03 / 从这里开始', destinationsTitle: '理解、使用，或者一起建设 Marivo', destinations: [['Docs', '开始一次可信分析', '安装 Marivo，准备语义层，让 Agent 沿着明确的路径分析业务问题。', '阅读文档', docsUrl], ['Blog', '理解设计与真实实践', '阅读 Marivo 的设计取舍、分析实践、版本演进与社区动态。', '阅读 Blog', blogUrl], ['GitHub', '查看代码与参与建设', '了解当前实现、提交问题，或者和我们一起完善 Agent 数据分析的基础设施。', '打开 GitHub', githubUrl]], footer: '面向 Agent 的数据分析 Harness',
    }
  : {
      lang: 'en', description: 'Marivo is a data analysis harness for AI agents, grounding open-ended investigations in governed semantics, typed operations, persistent sessions, and traceable evidence.', title: 'Marivo · A Data Analysis Harness for AI Agents', homeLabel: 'Marivo home', navLabel: 'Primary navigation', language: '简体中文',
      eyebrow: 'A Data Analysis Harness for AI Agents', headline: ['Let intelligence explore', 'Keep every result grounded'], heroCopy: 'Marivo is the runtime layer between an AI agent and business data. It keeps business meaning, analytical steps, session state, and evidence connected, so findings used in operations, governance, and decision-making remain inspectable, resumable, and traceable.', start: 'Get started', github: 'View on GitHub', readBlog: "Explore Marivo's design and practice",
      pathLabel: '01 / Analysis path', pathTitle: 'From an open question to a reviewable conclusion', pathIntro: 'The agent chooses how to investigate. Marivo keeps each step within explicit, verifiable boundaries.', questionLabel: 'Business question', question: 'Why did revenue decline last quarter, and which region should we investigate first?', questionMeta: ['Decision is clear', 'Metric definition pending'],
      steps: [['Semantics', 'What does the metric mean?', 'Validate'], ['Analysis', 'Which step is valid next?', 'Execute'], ['Session', 'What has already been done?', 'Preserve'], ['Evidence', 'What supports the finding?', 'Trace']], handoffLabel: 'Analysis handoff', handoff: 'Findings remain attached to their evidence, scope, and limitations.', inspectable: 'Reviewable',
      foundationLabel: '02 / Four foundations', foundationTitle: 'Agent autonomy needs dependable boundaries.', foundations: [['Establish shared business meaning', 'Define metrics, dimensions, relationships, and guardrails once as reusable contracts rather than reconstructing them in every analysis.', 'Semantic Layer'], ['Make each analytical step explicit', 'The agent chooses what to do next, while typed inputs, outputs, and failure modes keep the work visible and reviewable.', 'Typed Analysis DSL'], ['Preserve the investigation', 'Questions, intermediate results, and analytical artifacts remain together in a persistent session that can be resumed and extended.', 'Analysis Session'], ['Keep findings connected to evidence', 'Material findings remain linked to source results, analytical scope, and limitations, making trust and traceability part of the handoff.', 'Evidence']],
      philosophyLabel: "Marivo's design philosophy", philosophyTitle: ['Let intelligence explore.', 'Let constraints keep it grounded.'], philosophyCopy: 'An error in personal exploration may cost an hour. In an enterprise, analysis drives operations, governance, and decisions. Once findings carry business consequences, trust and traceability are not optional—they are prerequisites for action.', signalLabel: 'Three conditions for trustworthy analysis', signals: ['Business definitions are explicit', 'The investigation is resumable', 'Every finding is traceable'],
      destinationsLabel: '03 / Start here', destinationsTitle: 'Learn Marivo, run an analysis, or contribute', destinations: [['Docs', 'Run your first governed analysis', 'Install Marivo, prepare a semantic layer, and give an agent a business question to investigate within explicit boundaries.', 'Read the docs', docsUrl], ['Blog', 'Read the thinking behind Marivo', 'Explore product design, analytical practice, release notes, and community updates.', 'Read the blog', blogUrl], ['GitHub', 'Inspect the code or contribute', 'Explore the implementation, open an issue, or help improve the infrastructure for agent-driven data analysis.', 'Open GitHub', githubUrl]], footer: 'A Data Analysis Harness for AI Agents',
    };
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#edf5f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{copy.title}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={homeUrl} aria-label={copy.homeLabel}>
          <img src={marivoMark.src} alt="" width="34" height="34" />
          <span>Marivo</span>
        </a>
        <nav aria-label={copy.navLabel}>
          <a href={docsUrl}>Docs</a>
          <a href={blogUrl}>Blog</a>
          <a href={githubUrl}>GitHub</a>
          <a href={discordUrl}>Discord</a>
          <a href={languageUrl}>{copy.language}</a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-mark" aria-hidden="true">
            <span class="orbit one"></span><span class="orbit two"></span>
            <picture>
              <source media="(prefers-reduced-motion: reduce)" srcset={marivoMark.src} />
              <img src={marivoMarkAnimated.src} alt="" width="150" height="150" />
            </picture>
          </div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 id="hero-title">{copy.headline[0]}<br />{copy.headline[1]}</h1>
          <p class="hero-copy">{copy.heroCopy}</p>
          <div class="hero-actions">
            <a class="button primary" href={docsUrl}>{copy.start} <span aria-hidden="true">→</span></a>
            <a class="button secondary" href={githubUrl}>{copy.github} <span aria-hidden="true">↗</span></a>
          </div>
          <a class="quiet-link" href={blogUrl}>{copy.readBlog} <span aria-hidden="true">→</span></a>
        </section>

        <section class="section analysis-path" aria-labelledby="path-title">
          <div class="section-heading">
            <p class="section-number">{copy.pathLabel}</p>
            <h2 id="path-title">{copy.pathTitle}</h2>
            <p>{copy.pathIntro}</p>
          </div>

          <div class="path-board">
            <div class="question-card">
              <span class="card-label">{copy.questionLabel}</span>
              <p>{copy.question}</p>
              <div class="meta"><span>{copy.questionMeta[0]}</span><span>{copy.questionMeta[1]}</span></div>
            </div>
            <div class="path-track" aria-label={copy.pathLabel}>
              {copy.steps.map((step, index) => <><article class={`path-step ${['semantic', 'analysis', 'session', 'evidence'][index]}`}><span class="step-index">{String(index + 1).padStart(2, '0')}</span><div><h3>{step[0]}</h3><p>{step[1]}</p></div><span class="step-state">{step[2]}</span></article>{index < 3 && <span class="arrow" aria-hidden="true">→</span>}</>)}
            </div>
            <div class="decision-card">
              <div><span class="card-label">{copy.handoffLabel}</span><p>{copy.handoff}</p></div>
              <span class="decision-status">{copy.inspectable}</span>
            </div>
          </div>
        </section>

        <section class="section foundation" aria-labelledby="foundation-title">
          <div class="section-heading compact">
            <p class="section-number">{copy.foundationLabel}</p>
            <h2 id="foundation-title">{copy.foundationTitle}</h2>
          </div>
          <div class="foundation-grid">
            {copy.foundations.map((item, index) => <article><span class="foundation-index">{String(index + 1).padStart(2, '0')}</span><h3>{item[0]}</h3><p>{item[1]}</p><span class="foundation-name">{item[2]}</span></article>)}
          </div>
        </section>

        <section class="philosophy" aria-labelledby="philosophy-title">
          <div class="philosophy-grid" aria-hidden="true"></div>
          <div class="philosophy-copy">
            <p class="section-number">{copy.philosophyLabel}</p>
            <h2 id="philosophy-title">{copy.philosophyTitle[0]}<br />{copy.philosophyTitle[1]}</h2>
            <p>{copy.philosophyCopy}</p>
          </div>
          <div class="signal-panel" aria-label={copy.signalLabel}>
            {copy.signals.map((signal, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><p>{signal}</p></div>)}
          </div>
        </section>

        <section class="section destinations" aria-labelledby="destinations-title">
          <div class="section-heading compact">
            <p class="section-number">{copy.destinationsLabel}</p>
            <h2 id="destinations-title">{copy.destinationsTitle}</h2>
          </div>
          <div class="destination-grid">
            {copy.destinations.map((item, index) => <a href={item[4]}><span class="destination-kicker">{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p><span class="destination-action">{item[3]} <b aria-hidden="true">{index === 2 ? '↗' : '→'}</b></span></a>)}
          </div>
        </section>
      </main>

      <footer>
        <a class="brand" href={homeUrl} aria-label={copy.homeLabel}><img src={marivoMark.src} alt="" width="30" height="30" /><span>Marivo</span></a>
        <p>{copy.footer}</p>
        <div><a href={docsUrl}>Docs</a><a href={blogUrl}>Blog</a><a href={githubUrl}>GitHub</a><a href={discordUrl}>Discord</a><a href={languageUrl}>{copy.language}</a></div>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;color:#123a31;background:#edf5f0;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}:global(a){color:inherit;text-decoration:none}
  .page-shell{min-height:100vh;overflow:hidden;background:radial-gradient(circle at 50% 7%,rgba(43,191,149,.2),transparent 26rem),linear-gradient(rgba(13,70,57,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(13,70,57,.045) 1px,transparent 1px),#edf5f0;background-size:auto,44px 44px,44px 44px,auto}
  .site-header,main,footer{width:min(1120px,calc(100% - 48px));margin-inline:auto}.site-header{display:flex;align-items:center;justify-content:space-between;padding:24px 0}.brand{display:inline-flex;align-items:center;gap:10px;font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;font-size:17px;font-weight:700;letter-spacing:-.03em;white-space:nowrap}.brand img{display:block;border-radius:9px;box-shadow:0 6px 18px rgba(13,70,57,.15)}nav,footer>div{display:flex;align-items:center;gap:8px}nav a,footer>div a{padding:9px 13px;color:#45665d;border-radius:10px;font-size:14px;white-space:nowrap;transition:.18s}nav a:hover,nav a:focus-visible,footer>div a:hover,footer>div a:focus-visible{color:#0d4639;background:rgba(255,255,255,.7);outline:none}
  .hero{position:relative;display:flex;min-height:670px;padding:60px 24px 98px;align-items:center;flex-direction:column;text-align:center}.hero-mark{position:relative;display:grid;width:190px;height:190px;margin-bottom:30px;place-items:center}.hero-mark picture{display:grid;place-items:center}.hero-mark img{position:relative;z-index:2;border-radius:26px;filter:drop-shadow(0 26px 30px rgba(13,70,57,.22))}.orbit{position:absolute;inset:4px;border:1px solid rgba(20,125,100,.2);border-radius:35% 65% 58% 42%;animation:orbit 16s linear infinite}.orbit.two{inset:-10px;border-color:rgba(20,125,100,.1);border-radius:62% 38% 43% 57%;animation-duration:24s;animation-direction:reverse}@keyframes orbit{to{transform:rotate(360deg)}}
  .eyebrow,.section-number,.card-label,.destination-kicker{margin:0;color:#147d64;font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.hero h1{max-width:1000px;margin:18px 0 0;color:#0d2f27;font-family:ui-monospace,"SFMono-Regular",Consolas,"PingFang SC",monospace;font-size:clamp(42px,6.4vw,72px);font-weight:650;letter-spacing:-.07em;line-height:1.08;text-wrap:balance}.hero-copy{max-width:800px;margin:28px 0 0;color:#526f67;font-size:16px;line-height:1.8;text-wrap:balance}.hero-actions{display:flex;margin-top:34px;align-items:center;gap:12px}.button{display:inline-flex;min-height:46px;padding:0 20px;align-items:center;justify-content:center;gap:18px;border:1px solid transparent;border-radius:12px;font-size:14px;font-weight:650;transition:.18s}.button:hover,.button:focus-visible{transform:translateY(-2px);outline:none}.button.primary{color:#effff9;background:#0d4639;box-shadow:0 12px 30px rgba(13,70,57,.2)}.button.secondary{color:#0d4639;border-color:rgba(13,70,57,.16);background:rgba(255,255,255,.72)}.quiet-link{margin-top:20px;color:#6a837c;font-size:13px}.quiet-link:hover,.quiet-link:focus-visible{color:#147d64;outline:none}
  .section{padding:96px 0;border-top:1px solid rgba(13,70,57,.13)}.section-heading{max-width:960px;margin:0 auto 46px;text-align:center}.section-heading.compact{margin-bottom:38px}.section-heading h2,.philosophy h2{margin:14px 0 0;color:#0d2f27;font-family:ui-monospace,"SFMono-Regular",Consolas,"PingFang SC",monospace;font-weight:650;letter-spacing:-.055em;line-height:1.2;text-wrap:balance}.section-heading h2{font-size:clamp(30px,3.8vw,44px)}.section-heading>p:last-child{max-width:720px;margin:18px auto 0;color:#607b73;line-height:1.75;text-wrap:pretty}
  .path-board{padding:38px;border:1px solid rgba(13,70,57,.13);border-radius:24px;background:linear-gradient(rgba(13,70,57,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(13,70,57,.035) 1px,transparent 1px),rgba(255,255,255,.7);background-size:28px 28px,28px 28px,auto;box-shadow:0 24px 80px rgba(13,70,57,.08)}.question-card,.decision-card{display:flex;width:min(100%,520px);margin-inline:auto;padding:20px;border:1px solid rgba(13,70,57,.12);border-radius:16px;background:#fff;box-shadow:0 10px 28px rgba(13,70,57,.07)}.question-card{flex-direction:column}.question-card p,.decision-card p{margin:10px 0 0;color:#183d34;font-size:15px;font-weight:600;line-height:1.55;text-wrap:pretty}.meta{display:flex;margin-top:16px;flex-wrap:wrap;gap:8px}.meta span,.step-state,.decision-status{display:inline-flex;padding:5px 8px;border-radius:8px;color:#547169;background:#edf5f0;font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;font-size:10px;letter-spacing:.04em;white-space:nowrap}
  .path-track{display:grid;margin:38px 0;grid-template-columns:repeat(7,auto);align-items:center;justify-content:center;gap:10px}.path-step{position:relative;display:flex;min-width:172px;min-height:142px;padding:18px;flex-direction:column;justify-content:space-between;border:1px solid rgba(13,70,57,.13);border-radius:16px;background:rgba(255,255,255,.92)}.path-step:before{position:absolute;top:-1px;right:18px;left:18px;height:3px;content:"";border-radius:0 0 4px 4px;background:#2bbf95}.path-step.analysis:before{background:#147d64}.path-step.session:before{background:#5f8f81}.path-step.evidence:before{background:#0d4639}.step-index{color:#86a097;font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;font-size:10px}.path-step h3{margin:0;color:#10382f;font-size:17px}.path-step p{margin:4px 0 0;color:#789087;font-size:12px;text-wrap:balance}.step-state{width:fit-content}.arrow{color:#7ea096}.decision-card{align-items:center;justify-content:space-between;border-color:rgba(43,191,149,.42);background:#f1fff9}.decision-status{margin-left:20px;flex:0 0 auto;color:#0d6b54;background:#d9f7eb}
  .foundation-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid rgba(13,70,57,.14);border-left:1px solid rgba(13,70,57,.14)}.foundation-grid article{position:relative;min-height:290px;padding:36px;border-right:1px solid rgba(13,70,57,.14);border-bottom:1px solid rgba(13,70,57,.14);background:rgba(255,255,255,.38);transition:background .18s}.foundation-grid article:hover{background:rgba(255,255,255,.72)}.foundation-index{color:#2bbf95;font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;font-size:11px}.foundation-grid h3{margin:58px 0 12px;color:#11392f;font-size:22px;text-wrap:balance}.foundation-grid p{margin:0;color:#5f7971;font-size:14px;line-height:1.8;text-wrap:balance}.foundation-name{position:absolute;right:36px;bottom:30px;color:#95aaa4;font-family:ui-monospace,"SFMono-Regular",Consolas,monospace;font-size:11px;white-space:nowrap}
  .philosophy{position:relative;display:grid;min-height:520px;margin:90px 0;padding:64px;overflow:hidden;grid-template-columns:1.25fr .75fr;align-items:center;gap:64px;border-radius:28px;color:#cfe7de;background:#0b2822;box-shadow:0 30px 90px rgba(13,70,57,.23)}.philosophy-grid{position:absolute;inset:0;opacity:.34;background:radial-gradient(circle at 78% 50%,rgba(43,191,149,.3),transparent 25%),linear-gradient(rgba(185,244,221,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(185,244,221,.06) 1px,transparent 1px);background-size:auto,36px 36px,36px 36px}.philosophy-copy,.signal-panel{position:relative;z-index:1}.philosophy .section-number{color:#5de0b9}.philosophy h2{color:#effff9;font-size:clamp(30px,3.4vw,40px)}.philosophy-copy>p:last-child{max-width:580px;margin:24px 0 0;color:#a9c3ba;font-size:15px;line-height:1.85;text-wrap:pretty}.signal-panel{padding:10px 26px;border:1px solid rgba(185,244,221,.15);border-radius:18px;background:rgba(7,31,26,.7);backdrop-filter:blur(12px)}.signal-panel>div{display:flex;min-height:92px;align-items:center;gap:24px;border-bottom:1px solid rgba(185,244,221,.12)}.signal-panel>div:last-child{border-bottom:0}.signal-panel span{color:#48d6ac;font:11px ui-monospace,monospace}.signal-panel p{margin:0;color:#e4f8f0;font-size:16px;text-wrap:balance}
  .destination-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.destination-grid>a{display:flex;min-height:330px;padding:28px;flex-direction:column;border:1px solid rgba(13,70,57,.13);border-radius:20px;background:rgba(255,255,255,.68);transition:.18s}.destination-grid>a:hover,.destination-grid>a:focus-visible{transform:translateY(-5px);border-color:rgba(20,125,100,.36);outline:none;box-shadow:0 22px 50px rgba(13,70,57,.11)}.destination-grid h3{margin:56px 0 14px;color:#10382f;font-size:20px;line-height:1.35;text-wrap:balance}.destination-grid p{margin:0;color:#617a73;font-size:14px;line-height:1.75;text-wrap:pretty}.destination-action{display:flex;margin-top:auto;padding-top:28px;align-items:center;justify-content:space-between;color:#147d64;font-size:13px;font-weight:650}.destination-action b{font-size:18px;font-weight:400}
  footer{display:grid;padding:36px 0 48px;grid-template-columns:1fr auto 1fr;align-items:center;border-top:1px solid rgba(13,70,57,.13)}footer p{margin:0;color:#789188;font-size:12px}footer>div{justify-content:flex-end}
  @media(max-width:980px){.path-track{grid-template-columns:repeat(2,1fr)}.arrow{display:none}.path-step{min-width:0}.philosophy{padding:48px;grid-template-columns:1fr;gap:42px}.destination-grid{grid-template-columns:1fr}.destination-grid>a{min-height:260px}}
