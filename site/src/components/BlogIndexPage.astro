---
import marivoMark from '../assets/marivo-mark.svg';
import agentFlowEn from '../assets/blog/agent-analysis-flow-en.png';
import agentFlowZh from '../assets/blog/agent-analysis-flow.png';
import analysisDslEn from '../assets/blog/analysis-dsl-agent-loop-en.png';
import analysisDslZh from '../assets/blog/analysis-dsl-agent-loop.png';
import semanticContractEn from '../assets/blog/semantic-layer-contract-en.png';
import semanticContractZh from '../assets/blog/semantic-layer-contract.png';
import '../styles/blog.css';

interface Props {
  locale: 'en' | 'zh-cn';
}

const { locale } = Astro.props;
const isZh = locale === 'zh-cn';
const githubUrl = 'https://github.com/chengxianglibra/marivo';
const homeUrl = isZh ? '/zh-cn/' : '/';
const blogUrl = isZh ? '/zh-cn/blog/' : '/blog/';
const docsUrl = isZh ? '/zh-cn/docs/latest/' : '/docs/latest/';
const languageUrl = isZh ? '/blog/' : '/zh-cn/blog/';
const siteUrl = Astro.site ?? new URL('https://marivo.io');
const englishUrl = new URL('/blog/', siteUrl);
const chineseUrl = new URL('/zh-cn/blog/', siteUrl);
const canonicalUrl = isZh ? chineseUrl : englishUrl;
const copy = isZh
  ? {
      lang: 'zh-CN', description: 'Marivo Blog：分享产品设计、分析实践、版本演进与社区动态。', homeLabel: 'Marivo 主页', navLabel: 'Blog 导航', language: 'English',
      headline: ['记录 Marivo 的设计、', '实践与演进。'], intro: '这里收录设计思想、真实分析实践、版本变化和社区故事。我们既讨论为什么这样设计，也记录 Marivo 如何进入具体的数据项目，以及它在使用中学到了什么。',
      meta: '最新文章 · 设计', date: '2026.08.14', articleTitle: 'Analysis DSL：约束分析动作，而不是约束 Agent\u00a0推理', articleSummary: '语义层定义完成后，怎样让它真正进入每一步计算？这篇文章讨论 Marivo 如何用可以检查和追踪的分析动作降低 Agent 的负担，同时保留开放的判断空间。', read: '阅读文章', imageAlt: 'Marivo Analysis DSL 面向 Agent 的 read、write、execute 循环',
      footer: '让智能自由探索，让约束守住事实。', home: '主页',
    }
  : {
      lang: 'en', description: 'The Marivo Blog covers product design, analytical practice, releases, and community updates.', homeLabel: 'Marivo home', navLabel: 'Blog navigation', language: '简体中文',
      headline: ['The design, practice,', 'and evolution of Marivo.'], intro: 'Essays on product design, field experience, release changes, and the community around Marivo. We explain the decisions behind the system and examine how they hold up in real data projects.',
      meta: 'Latest · Design', date: '2026.08.14', articleTitle: 'Analysis DSL: Constrain Analytical Actions, Not Agent Reasoning', articleSummary: 'A semantic layer defines trusted business objects. This article explains how Marivo makes those objects govern every analytical action while leaving hypotheses, direction, and interpretation to the agent.', read: 'Read article', imageAlt: 'The Marivo Analysis DSL supporting an agent read-write-execute loop with inspectable actions and explicit results',
      footer: 'Let intelligence explore. Let constraints keep it grounded.', home: 'Home',
    };
const featured = isZh
  ? {
      url: `${blogUrl}analysis-dsl-constrains-actions-not-agent-reasoning/`,
      image: analysisDslZh,
    }
  : {
      url: `${blogUrl}analysis-dsl-constrains-actions-not-agent-reasoning/`,
      image: analysisDslEn,
    };
const archiveLabel = isZh ? '更多文章' : 'More articles';
const articles = isZh
  ? [
      {
        url: `${blogUrl}semantic-layer-as-an-agent-contract/`,
        image: semanticContractZh,
        meta: '设计 · 语义层',
        date: '2026.08.09',
        title: '语义层：把业务含义变成 Agent 可以依赖的代码契约',
        summary: '语义层为什么是数据分析 Agent 的必要边界，以及 Marivo 如何用 Python、Git、验证和可检查的证据，把业务含义变成稳定契约。',
      },
      {
        url: `${blogUrl}why-data-analysis-agents-need-a-harness/`,
        image: agentFlowZh,
        meta: '设计综述',
        date: '2026.08.05',
        title: '为什么数据分析 Agent 需要 Harness，而不只是生成 SQL',
        summary: '从语义、受约束的分析动作、session、evidence 和 Agent 接口出发，理解 Marivo 想解决的问题与责任边界。',
      },
    ]
  : [
      {
        url: `${blogUrl}semantic-layer-as-an-agent-contract/`,
        image: semanticContractEn,
        meta: 'Design · Semantic layer',
        date: '2026.08.09',
        title: 'The Semantic Layer: Turning Business Meaning into an Executable Contract for Agents',
        summary: 'Why agents cannot derive approved business meaning from schemas alone—and how Marivo uses semantic objects, Python, Git, runtime validation, and CI to keep that meaning dependable.',
      },
      {
        url: `${blogUrl}why-data-analysis-agents-need-a-harness/`,
        image: agentFlowEn,
        meta: 'Design overview',
        date: '2026.08.05',
        title: 'Why Data Analysis Agents Need a Harness, Not Just SQL Generation',
        summary: 'How governed semantics, typed analysis, persistent sessions, and traceable evidence give open-ended agent analysis dependable boundaries.',
      },
    ];
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#f6f3eb" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Marivo Blog</title>
  </head>
  <body class="blog-body">
    <div class="blog-page">
      <header class="blog-header">
        <a class="blog-brand" href={homeUrl} aria-label={copy.homeLabel}>
          <img src={marivoMark.src} alt="" width="32" height="32" />
          <span>Marivo</span>
        </a>
        <span class="blog-divider" aria-hidden="true"></span>
        <a class="blog-name" href={blogUrl}>Blog</a>
        <nav aria-label={copy.navLabel}>
          <a href={docsUrl}>Docs</a>
          <a href={githubUrl}>GitHub</a>
          <a href={languageUrl}>{copy.language}</a>
        </nav>
      </header>

      <main class="blog-home">
        <section class="blog-hero" aria-labelledby="blog-title">
          <p class="blog-kicker">Marivo / Blog</p>
          <h1 id="blog-title">{copy.headline[0]}<br />{copy.headline[1]}</h1>
          <p>{copy.intro}</p>
        </section>

        <section class="featured" aria-labelledby="featured-title">
          <div class="featured-copy">
            <div class="featured-meta"><span>{copy.meta}</span><span>{copy.date}</span></div>
            <h2 id="featured-title">{copy.articleTitle}</h2>
            <p>{copy.articleSummary}</p>
            <a href={featured.url}>{copy.read} <span aria-hidden="true">→</span></a>
          </div>
          <a class="featured-visual" href={featured.url} aria-label={copy.articleTitle}>
            <img src={featured.image.src} alt={copy.imageAlt} />
          </a>
        </section>

        {articles.length > 0 && (
          <section class="article-archive" aria-labelledby="archive-title">
            <div class="archive-heading">
              <p class="blog-kicker">Archive</p>
              <h2 id="archive-title">{archiveLabel}</h2>
            </div>
            <div class="archive-grid">
              {articles.map((article) => (
                <a class="archive-card" href={article.url}>
                  <div class="archive-image"><img src={article.image.src} alt="" /></div>
                  <div class="archive-copy">
                    <div class="featured-meta"><span>{article.meta}</span><span>{article.date}</span></div>
                    <h3>{article.title}</h3>
                    <p>{article.summary}</p>
                    <span class="archive-link">{copy.read} <span aria-hidden="true">→</span></span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </main>

      <footer class="blog-footer">
        <div><img src={marivoMark.src} alt="" width="28" height="28" /><p>{copy.footer}</p></div>
        <div class="blog-footer-links"><a href={homeUrl}>{copy.home}</a><a href={blogUrl}>Blog</a><a href={docsUrl}>Docs</a><a href={githubUrl}>GitHub</a><a href={languageUrl}>{copy.language}</a></div>
      </footer>
    </div>
  </body>
</html>
