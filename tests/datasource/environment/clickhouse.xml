<clickhouse>
    <max_server_memory_usage>2147483648</max_server_memory_usage>
    <logger>
        <level>warning</level>
        <size>10M</size>
        <count>2</count>
    </logger>
    <query_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>
    <remote_servers>
        <marivo_single_shard>
            <secret>marivo-single-shard-cluster</secret>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9000</port>
                </replica>
            </shard>
        </marivo_single_shard>
    </remote_servers>
</clickhouse>
